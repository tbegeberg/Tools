{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cupertino": {
      "type": "local",
      "command": ["/opt/homebrew/bin/cupertino", "serve"],
      "enabled": true
    },
    "xcode": {
      "type": "local",
      "command": ["xcrun", "mcpbridge"],
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "oauth": false,
      "enabled": true 
    },
    "knowledge": {
      "type": "local",
      "command": ["/Users/torkegeberg/Documents/Knowledge/Knowledge/mcp-knowledge/run.sh"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "xcodebuild": "deny",
      "xcodebuild *": "deny",
      "swift build": "deny",
      "swift build *": "deny",
      "swift test": "deny",
      "swift test *": "deny",
      "fastlane": "deny",
      "fastlane *": "deny",
      "tuist build": "deny",
      "tuist build *": "deny",
      "tuist test": "deny",
      "tuist test *": "deny"
    },
    "figma_*": "ask",
    "figma_get_*": "allow",
    "figma_add_*": "deny",
    "figma_send_*": "deny"
  }
}
